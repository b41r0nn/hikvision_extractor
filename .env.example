# ──────────────────────────────────────────────────────────────────────────────
# .env.example — Copia este archivo como ".env" y completa los valores reales.
# NUNCA subas el archivo .env real a un repositorio de código.
# ──────────────────────────────────────────────────────────────────────────────

# ── Base de Datos ─────────────────────────────────────────────────────────────
# URL de conexión a PostgreSQL. En Docker usa el nombre del servicio "db".
DATABASE_URL=postgresql://admin:adminpassword@db:5432/hikvision

# Credenciales del servidor PostgreSQL (deben coincidir con docker-compose.yml)
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminpassword
POSTGRES_DB=hikvision

# ── Biométrico Hikvision ───────────────────────────────────────────────────────
# Dirección IP del dispositivo biométrico en la red local
DEVICE_IP=192.168.1.127
DEVICE_USER=admin
# Contraseña de administrador del biométrico
DEVICE_PASS=tu_password_del_biometrico

# ── Backfill automático al arrancar ─────────────────────────────────────────────
# Techo duro en segundos para el hilo de backfill que se ejecuta al arrancar
# el backend (recupera los días entre la última extracción exitosa y hoy).
# Si el backfill supera este tiempo, un watchdog mata el proceso y Docker
# (restart: always) lo levanta de nuevo; el siguiente arranque reintenta
# desde el último día exitoso (el backfill commitea día por día, por lo que
# el progreso ya commiteado NO se pierde al matar el proceso).
#
# Valor por defecto: 3600s (1h). Con ~80s por día medidos en pruebas, esto
# cubre aproximadamente un gap de 1 semana con margen. Si tu dispositivo es
# más lento o esperas caídas más largas, sube este valor proporcionalmente.
# Ponlo en 0 para desactivar el watchdog (no recomendado en producción).
BACKFILL_TIMEOUT_SEC=3600

# ── Correo (Gmail con contraseña de aplicación) ───────────────────────────────
# Instrucciones para obtener contraseña de aplicación Gmail:
# 1. Activar verificación en 2 pasos en tu cuenta Google.
# 2. Ir a: Cuenta de Google → Seguridad → Contraseñas de aplicación.
# 3. Crear una contraseña para "Correo" y "Otro dispositivo (nombre: REDIHOS)".
# 4. Copiar los 16 caracteres generados en SMTP_APP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
# Los 16 caracteres SIN espacios de la contraseña de aplicación Google
SMTP_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Destinatarios de reportes automáticos (separados por coma, sin espacios)
# Ejemplo: rrhh@redihos.com,gerencia@redihos.com
REPORT_RECIPIENTS=rrhh@redihos.com

# ── Configuración de Asistencia (valores por defecto) ─────────────────────────
# DEPRECADO (Fase A del versionado de horarios): DEFAULT_TURNO_ENTRADA y
# DEFAULT_TOLERANCIA_MINUTOS ya NO se usan en el cálculo de tardanzas.
# A partir de Fase A todo empleado debe tener un turno_id real y su horario se
# lee desde la tabla turno_horario. Se mantienen aquí solo por si se necesita
# revertir rápidamente; se eliminarán del código en una migración futura.
# Hora de entrada por defecto para empleados sin turno asignado (formato HH:MM)
DEFAULT_TURNO_ENTRADA=07:30
# Minutos de tolerancia antes de marcar como "tarde"
DEFAULT_TOLERANCIA_MINUTOS=10
# Ventana de fusión en minutos: marcas del mismo empleado/día dentro de esta
# ventana se muestran como UNA sola "Marca N" en el Excel. Use 0 para desactivar.
MARCA_FUSION_MINUTOS=2

# ── Seguridad (JWT) ───────────────────────────────────────────────────────────
# SECRET_KEY firma los tokens JWT. NO copies el valor de abajo literalmente.
# Generá una clave real con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Ejemplo de salida (cambiar antes de producción):
#   SECRET_KEY=XcIqJ5XC16247GAtquwcat6-RpfuDzv_bYv-j9A_514
SECRET_KEY=tu_secret_key_para_jwt_cambiar_en_produccion
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Usuario administrador inicial (cambiar contraseña en producción)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Ingreso2026*
